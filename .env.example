# --- App -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:5173
DEFAULT_LOCALE=ta            # ta | en

# --- Database --------------------------------------------------------------
DATABASE_URL=postgres://kadai:kadai@localhost:5432/kadai

# --- Shop identity (appears on invoices; must match the GST portal) --------
SHOP_LEGAL_NAME=Annachi Kadai Co
SHOP_GSTIN=33AAAAA0000A1Z5
SHOP_STATE_CODE=33           # 33 = Tamil Nadu
SHOP_ADDRESS=12, Bazaar Street, Virudhunagar, Tamil Nadu - 626001
SHOP_UPI_ID=annachikadai@okhdfcbank

# --- Payment collection (ADR-0007) ------------------------------------------
# Invoice payment only — UPI reuses SHOP_UPI_ID above, no separate account.
# Razorpay/Cashfree stay disabled (503 from their routes) until a key pair is
# set; get test keys from each dashboard's sandbox before going further.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=     # separate from the API key pair — set in the Razorpay dashboard's webhook config
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=         # also the webhook-signing secret — Cashfree has no separate one
CASHFREE_ENV=sandbox         # sandbox | production

# --- Tally -----------------------------------------------------------------
# Tally Prime must be running with XML over HTTP enabled on the LAN.
TALLY_HOST=http://localhost:9000
TALLY_COMPANY=
TALLY_ENABLED=false          # false => generate the XML file only

# --- GSTN ------------------------------------------------------------------
# M2 ships offline-utility JSON only. GSP credentials stay unset until ADR-0003
# is decided (see docs/decisions/0003-gsp-integration-or-json-export.md).
GSP_PROVIDER=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=

# --- Messaging -------------------------------------------------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
